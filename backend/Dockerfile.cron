# PostizMetro cron only: Postiz NestJS 10, Node 22.
# Split build (2026-10-30, DEPLOY4): builds ONLY the cron app.
# See Dockerfile.backend for the timeout rationale and .npmrc note.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@10.6.1
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsconfig.base.json .npmrc ./
COPY libraries ./libraries
COPY apps ./apps
COPY scripts ./scripts
COPY i18n.json i18n.lock version.txt ./
RUN pnpm install --ignore-scripts
RUN pnpm dlx prisma@6.5.0 generate --schema ./libraries/nestjs-libraries/src/database/prisma/schema.prisma
RUN NODE_OPTIONS=--max-old-space-size=4096 pnpm run build:cron
ENV PORT=3000
EXPOSE 3000
CMD ["node", "apps/cron/dist/apps/cron/src/main.js"]
