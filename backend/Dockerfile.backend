# PostizMetro backend only: Postiz NestJS 10, Node 22 (engines >=22.12 <23).
# Split build (2026-10-30, DEPLOY4): builds ONLY the backend app, not workers
# or cron, so this single Coolify deployment fits under the 3600s timeout.
# The previous combined Dockerfile built all three nest apps in one job and
# exceeded 3600s on the nest build step alone, with 0 TypeScript errors.
# .npmrc is required: it sets node-linker=hoisted, which upstream Postiz
# relies on for type resolution (express, form-data, mastra, etc.).
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@10.6.1
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsconfig.base.json .npmrc ./
COPY libraries ./libraries
COPY apps ./apps
COPY scripts ./scripts
COPY i18n.json i18n.lock version.txt ./
RUN pnpm install
# NOTE: do NOT use --ignore-scripts here: bcrypt's native binding is built
# by its install script, and ignoring scripts caused
# 'Cannot find module bcrypt/lib/binding/napi-v3/bcrypt_lib.node' at runtime.
RUN pnpm dlx prisma@6.5.0 generate --schema ./libraries/nestjs-libraries/src/database/prisma/schema.prisma
RUN NODE_OPTIONS=--max-old-space-size=4096 pnpm run build:backend
ENV PORT=3000
EXPOSE 3000
CMD ["node", "apps/backend/dist/apps/backend/src/main.js"]
