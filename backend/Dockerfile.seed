# PostizMetro seed-only image, FIX-401.
# Fast: no Nest build, only Prisma client + seed script.
# Use for a one-off seed run only, then delete the seed app.
# It runs prisma db push (creates tables if missing) then the fixed
# seed script, which creates/updates the review user and organisation
# with the env IDs that PublicWorkspaceMiddleware looks up by.
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.seed.json ./package.json
COPY libraries/nestjs-libraries/src/database/prisma/schema.prisma ./prisma/schema.prisma
COPY scripts/seed-review-workspace.mjs ./seed.mjs
RUN npm install --no-audit --no-fund
RUN npx prisma generate --schema ./prisma/schema.prisma
CMD ["sh", "-c", "npx prisma db push --schema ./prisma/schema.prisma && node seed.mjs"]
